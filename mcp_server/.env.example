# Copy to mcp_server/.env and set absolute paths (Windows: C:/Users/me/data).
# The folder of your datasets (mounted read-write on /data in the server)
SIMPLATAB_DATA=/home/me/simplatab/data
# The folder where the experiments, trained models and uploads are kept
SIMPLATAB_OUTPUT=/home/me/simplatab/workspace
# Port of http://localhost:<port>/mcp
SIMPLATAB_MCP_PORT=8000
# Runs executed at the same time (the others wait in a queue)
SIMPLATAB_MAX_PARALLEL=1
